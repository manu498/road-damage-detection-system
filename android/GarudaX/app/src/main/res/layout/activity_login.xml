<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= BACKGROUND IMAGE ================= -->

    <ImageView
        android:id="@+id/loginBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/login_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Slight dark transparent layer -->
    <!-- This makes the login controls easier to see -->

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#18000000" />

    <!-- ================= LOGIN CONTENT ================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Login Card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/login_card"
                android:elevation="10dp">

                <!-- Welcome -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back!"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#102A63"
                    android:gravity="center" />

                <!-- Subtitle -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sign in to continue to your account"
                    android:textSize="15sp"
                    android:textColor="#52689A"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="22dp" />

                <!-- ================= EMAIL ================= -->

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Email Address"
                    android:textSize="16sp"
                    android:textColor="#102A63"
                    android:textColorHint="#7182AA"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/login_input" />

                <!-- ================= PASSWORD ================= -->

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Password"
                    android:textSize="16sp"
                    android:textColor="#102A63"
                    android:textColorHint="#7182AA"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/login_input" />

                <!-- ================= LOGIN BUTTON ================= -->

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="LOGIN  →"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/login_button"
                    android:elevation="4dp" />

                <!-- ================= OR ================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="────────  OR  ────────"
                    android:textSize="14sp"
                    android:textColor="#6879A8"
                    android:gravity="center"
                    android:layout_marginTop="18dp" />

                <!-- ================= REGISTER ================= -->

                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="Don't have an account?  REGISTER"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1769E0"
                    android:background="@android:color/transparent"
                    android:layout_gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>