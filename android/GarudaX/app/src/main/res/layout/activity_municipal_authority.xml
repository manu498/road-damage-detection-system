<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Municipal Authority"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="25dp" />

        <TextView
            android:id="@+id/tvComplaintId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complaint ID: RD001"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location: Main Road"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvDamageType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Damage Type: Pothole"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description: Large pothole on the road."
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Status: Under Review"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="10dp"
            android:layout_marginTop="15dp" />

        <Button
            android:id="@+id/btnViewComplaint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIEW COMPLAINT"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UPDATE REPAIR STATUS"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>