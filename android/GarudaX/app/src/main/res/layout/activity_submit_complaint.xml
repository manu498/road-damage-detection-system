<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit Road Complaint"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <ImageView
        android:id="@+id/imgComplaint"
        android:layout_width="180dp"
        android:layout_height="130dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:scaleType="centerCrop"
        android:contentDescription="Selected road damage image"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnSelectImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SELECT / UPLOAD IMAGE"
        android:layout_marginBottom="15dp" />

    <EditText
        android:id="@+id/etLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Road Location"
        android:inputType="text"
        android:padding="12dp" />

    <EditText
        android:id="@+id/etDamageType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Damage Type (Pothole, Crack, etc.)"
        android:inputType="text"
        android:layout_marginTop="10dp"
        android:padding="12dp" />

    <EditText
        android:id="@+id/etDescription"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:hint="Describe the road damage"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:layout_marginTop="10dp"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SUBMIT COMPLAINT"
        android:layout_marginTop="20dp" />

</LinearLayout>